POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_dev_change_me

AKL_DB_NAME=akl
AKL_DB_API_USER=akl_api
AKL_DB_API_PASSWORD=akl_api_dev_change_me
AKL_DB_PIPELINE_USER=akl_pipeline
AKL_DB_PIPELINE_PASSWORD=akl_pipeline_dev_change_me
AIRFLOW_DB_NAME=airflow
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=airflow_dev_change_me
MLFLOW_DB_NAME=mlflow
MLFLOW_DB_USER=mlflow
MLFLOW_DB_PASSWORD=mlflow_dev_change_me

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin_dev_change_me
MINIO_BROWSER_REDIRECT_URL=http://localhost:9001
AKL_S3_BUCKET=akl-lakehouse
AKL_S3_ACCESS_KEY=akl_service
AKL_S3_SECRET_KEY=akl_service_dev_change_me_32chars
AKL_QUARANTINE_RETENTION_DAYS=90
AKL_BACKUP_RETENTION_DAYS=14

AKL_DEV_POSTGRES_PORT=5432
AKL_DEV_MINIO_API_PORT=9000
AKL_DEV_MINIO_CONSOLE_PORT=9001
AKL_DEV_QDRANT_HTTP_PORT=6333
AKL_DEV_QDRANT_GRPC_PORT=6334

# ============================================================================
# Milestone 3 - application settings consumed by akl.config.Settings
# Host-side values (localhost). Containers use configs/settings.yaml defaults.
# ============================================================================

AKL_ENV=dev
AKL_SERVICE_NAME=akl-cli
AKL_LOG_LEVEL=INFO
AKL_ORG_NAME=Example Org
# AKL_CONFIG_FILE=configs/settings.yaml

AKL_DB_HOST=localhost
AKL_DB_PORT=5432
AKL_DB_NAME=akl
AKL_DB_USER=akl_pipeline
AKL_DB_PASSWORD=akl_pipeline_dev_change_me
AKL_DB_SSLMODE=disable
# AKL_DB_PASSWORD_FILE=/run/secrets/akl_db_password

AKL_S3_ENDPOINT=http://localhost:9000
AKL_S3_REGION=us-east-1
AKL_S3_USE_SSL=false
AKL_S3_PATH_STYLE=true

AKL_QDRANT_URL=http://localhost:6333
AKL_QDRANT_GRPC_PORT=6334
AKL_QDRANT_PREFER_GRPC=true
# AKL_QDRANT_API_KEY=

# ============================================================================
# Batch C — embeddings & Qdrant (host-side)
# ============================================================================
# Model cache: the default /models is the container path; on a laptop keep models inside the repo
# (the folder is git-ignored). bge-small ONNX (~130 MB) is downloaded from the Hugging Face Hub on first use.
AKL_MODELS_DIR=./models
# AKL_EMBED_PROVIDER=bge          # bge (default) | hash (deterministic offline provider, tests/demos only)
# AKL_EMBED_BATCH_SIZE=64
# AKL_EMBED_ONNX_INT8=false       # true: onnx/model_quantized.onnx (~1.8x faster, <0.5% quality loss)

# ============================================================================
# Batch E — API & LLM (host-side)
# ============================================================================
AKL_AUTH_DISABLED=true          # dev only: every request runs as the dev principal
AKL_JWT_SECRET=change-me-please-32-characters-min
# AKL_API_KEY_PEPPER=another-long-random-string
# AKL_LLM_PROVIDER=openai_compat   # default none → extractive cited answers
# AKL_LLM_BASE_URL=http://localhost:11434/v1   # Ollama / llama.cpp / vLLM (OpenAI-compatible)
# AKL_LLM_MODEL=llama3.1:8b
# AKL_LLM_API_KEY=

# ============================================================================
# Batch F — Airflow (containers only)
# ============================================================================
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_FERNET_KEY=
AIRFLOW_WEBSERVER_SECRET_KEY=akl-dev-webserver-key
AKL_DEV_AIRFLOW_PORT=8080

# ============================================================================
# Batch G — Observability (containers only, except the two AKL_* toggles)
# ============================================================================
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
AKL_DEV_GRAFANA_PORT=3000
AKL_DEV_PROMETHEUS_PORT=9090
AKL_DEV_MLFLOW_PORT=5000
# Enable pipeline metrics push from DAG tasks / `akl-cli pipeline ...` (needs the pushgateway service):
# AKL_PUSHGATEWAY_URL=http://pushgateway:9091
# Enable tracing (needs `docker compose --profile tracing up otel-collector`):
# AKL_OTEL_ENABLED=true
# Enable MLflow logging for embedding runs (needs `docker compose --profile mlflow up mlflow`):
# AKL_MLFLOW_ENABLED=true
